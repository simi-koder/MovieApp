<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Movies" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:colorBackground">@color/background</item>
    </style>

    <style name="CustomPopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:colorBackground">@color/secondary</item>
    </style>

    <style name="Theme.Movies" parent="Base.Theme.Movies">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="popupMenuStyle">@style/CustomPopupMenu</item>
    </style>
</resources>