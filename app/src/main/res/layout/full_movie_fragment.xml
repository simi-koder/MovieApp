<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/fullMovieTitle"
            android:layout_width="287dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:maxLines="3"
            android:text="placeholderTitle"
            android:textSize="25dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.495"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="300dp" />

        <TextView
            android:id="@+id/fullMovieDirector"
            android:layout_width="277dp"
            android:layout_height="42dp"
            android:layout_marginTop="60dp"
            android:gravity="center"
            android:text="placeholderDirector"
            android:textSize="20dp"
            android:textStyle="italic"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fullMovieTitle" />

        <CheckBox
            android:id="@+id/videl1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="placehodler 1"
            android:visibility="gone"
            android:textColor="@color/white"
            app:buttonTint="@color/checkbox_color_selector"
            app:layout_constraintEnd_toStartOf="@+id/videl2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/descriptionPlaceholder" />

        <CheckBox
            android:id="@+id/videl2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="placeholder 2"
            android:visibility="gone"
            android:textColor="@color/white"
            app:buttonTint="@color/checkbox_color_selector"
            app:layout_constraintEnd_toStartOf="@+id/videl3"
            app:layout_constraintStart_toEndOf="@+id/videl1"
            app:layout_constraintTop_toTopOf="@+id/videl1" />

        <CheckBox
            android:id="@+id/videl3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="placeholder 3"
            android:visibility="gone"
            android:textColor="@color/white"
            app:buttonTint="@color/checkbox_color_selector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/videl2"
            app:layout_constraintTop_toTopOf="@+id/videl1" />

        <CheckBox
            android:id="@+id/videl4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="placehodler 4"
            android:visibility="gone"
            android:textColor="@color/white"
            app:buttonTint="@color/checkbox_color_selector"
            app:layout_constraintEnd_toStartOf="@+id/videl5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/videl1" />

        <CheckBox
            android:id="@+id/videl5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="placeholder 5"
            android:visibility="gone"
            android:textColor="@color/white"
            app:buttonTint="@color/checkbox_color_selector"
            app:layout_constraintEnd_toStartOf="@+id/videl6"
            app:layout_constraintStart_toEndOf="@+id/videl4"
            app:layout_constraintTop_toTopOf="@+id/videl4" />

        <CheckBox
            android:id="@+id/videl6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="placeholder 6"
            android:visibility="gone"
            android:textColor="@color/white"
            app:buttonTint="@color/checkbox_color_selector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/videl5"
            app:layout_constraintTop_toTopOf="@+id/videl5" />

        <CheckBox
            android:id="@+id/videl7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="placehodler 7"
            android:visibility="gone"
            android:textColor="@color/white"
            app:buttonTint="@color/checkbox_color_selector"
            app:layout_constraintEnd_toStartOf="@+id/videl8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/videl4" />

        <CheckBox
            android:id="@+id/videl8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="placeholder 8"
            android:visibility="gone"
            android:textColor="@color/white"
            app:buttonTint="@color/checkbox_color_selector"
            app:layout_constraintEnd_toStartOf="@+id/videl9"
            app:layout_constraintStart_toEndOf="@+id/videl7"
            app:layout_constraintTop_toTopOf="@+id/videl7" />

        <CheckBox
            android:id="@+id/videl9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="placeholder 9"
            android:visibility="gone"
            android:textColor="@color/white"
            app:buttonTint="@color/checkbox_color_selector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/videl8"
            app:layout_constraintTop_toTopOf="@+id/videl8" />

        <CheckBox
            android:id="@+id/videl10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="placeholder 10"
            android:visibility="gone"
            android:textColor="@color/white"
            app:buttonTint="@color/checkbox_color_selector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/videl8" />

        <!--            comment constraints if want to align-->
        <CheckBox
            android:id="@+id/videneSpoluCheck"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Videné spolu"
            android:visibility="gone"
            android:textColor="@color/white"
            app:buttonTint="@color/checkbox_color_selector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/videl10" />


        <TextView
            android:id="@+id/fullMovieGenres"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:maxLines="3"
            android:text="placeholderGenres"
            android:textSize="25dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/videneSpoluCheck" />

        <TextView
            android:id="@+id/fullMovieYear"
            android:layout_width="167dp"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="placeholderYear"
            android:textSize="18dp"
            android:textColor="@color/white"
            app:layout_constraintBottom_toTopOf="@+id/fullMovieDirector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fullMovieTitle"
            app:layout_constraintVertical_bias="0.187" />

        <TextView
            android:id="@+id/fullMoviePriority"
            android:layout_width="204dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="placeholderPriority"
            android:textSize="20dp"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fullMovieOurRating" />

        <TextView
            android:id="@+id/fullMovieRating"
            android:layout_width="205dp"
            android:layout_height="54dp"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:text="placeholderRating"
            android:textSize="20dp"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.495"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fullMovieGenres" />

        <TextView
            android:id="@+id/fullMovieOurRating"
            android:layout_width="205dp"
            android:layout_height="57dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="placeholderOurRating"
            android:textSize="20dp"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.495"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fullMovieRating" />

        <CheckBox
            android:id="@+id/fullMovieColor"
            android:layout_width="123dp"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:text="Farebné"
            android:textColor="@color/white"
            app:buttonTint="@color/checkbox_color_selector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.545"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fullMoviePriority" />

        <TextView
            android:id="@+id/descriptionPlaceholder"
            android:layout_width="284dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="left"
            android:textSize="16dp"
            android:visibility="gone"
            android:text="placeholderDescription"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.502"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fullMovieDirector" />

        <Button
            android:id="@+id/editMovieBtnDetail"
            android:layout_width="150dp"
            android:layout_height="45dp"
            android:layout_marginTop="32dp"
            android:text="Editovať"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fullMovieColor" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>